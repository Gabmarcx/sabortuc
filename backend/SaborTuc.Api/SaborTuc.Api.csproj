<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SaborTuc.Api</RootNamespace>
    <!-- permite correr en un runtime más nuevo si no tenés instalado el 6 -->
    <RollForward>Major</RollForward>
    <!-- .NET 6 está fuera de soporte; ocultamos el aviso -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <UserSecretsId>2cb996cc-6aae-4cd2-8278-20efdbe53887</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="6.0.33" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="6.0.33" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="Data\restaurants.seed.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
